{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "django",
      "buildCommand": "python manage.py migrate --no-input && python manage.py seed_demo"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)",    "destination": { "service": "backend" } },
    { "source": "/admin/(.*)",  "destination": { "service": "backend" } },
    { "source": "/static/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)",        "destination": { "service": "frontend" } }
  ],
  "headers": [ { "source": "/(.*)", "headers": [ /* nosniff, X-Frame-Options DENY, Referrer-Policy */ ] } ]
}