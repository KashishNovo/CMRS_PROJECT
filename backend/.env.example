# Copy to .env (or export these) for local development.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cmrs
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Optional (defaults shown)
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_HOURS=12
# LOGIN_THROTTLE_RATE=10/min
# MAX_CASH_RECEIPT=199999.99
# DUPLICATE_WINDOW_MINUTES=30
# SETTLEMENT_SLA_DAYS=2
# APP_TIME_ZONE=Asia/Kolkata
# LOG_LEVEL=INFO
